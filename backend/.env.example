# ============================================
# Food Calorie Analyzer - Environment Config
# ============================================
# Architecture: Docker-based AI Services
# - MongoDB: Docker container
# - YOLO: Docker (Food Detection)
# - Gemma 4:26B: Docker (Nutrition Suggestions)
# - USDA API: External (Nutrition Database)

# ============================================
# Docker Services Configuration
# ============================================

# MongoDB (Docker)
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB_NAME=food_calorie_app

# YOLO Food Detection (Docker)
YOLO_HOST=yolo
YOLO_PORT=8001
YOLO_TIMEOUT=30
YOLO_CONFIDENCE=0.25

# Gemma 4:26B (External Docker - already running)
GEMMA_HOST=host.docker.internal
GEMMA_PORT=12434
GEMMA_MODEL=docker.io/ai/gemma4:26B
GEMMA_TIMEOUT=60

# ============================================
# External API Configuration
# ============================================

# USDA FoodData Central (Nutrition Data)
# Get from: https://api.nal.usda.gov/
USDA_API_KEY=your_usda_api_key_here

# ============================================
# Processing Configuration
# ============================================

# Offline Mode (true = no external APIs, use cached/estimated data only)
OFFLINE_MODE=false

# Confidence threshold for food detection
CONFIDENCE_THRESHOLD=0.3

# Default portion size for estimation
DEFAULT_PORTION_SIZE=100

# Cache duration for nutrition data (seconds)
NUTRITION_CACHE_DURATION=3600

# ============================================
# API Configuration
# ============================================

# Backend API
API_HOST=0.0.0.0
API_PORT=8000

# CORS Settings
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# ============================================
# Logging Configuration
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path
LOG_FILE=/app/logs/app.log

# ============================================
# Performance Configuration
# ============================================

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# Maximum image size (MB)
MAX_IMAGE_SIZE=10

# ============================================
# Security Configuration
# ============================================

# JWT Secret Key (change in production)
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# Development Settings
# ============================================

# Enable auto-reload (development only)
RELOAD=true

# Enable debug mode
DEBUG=false
