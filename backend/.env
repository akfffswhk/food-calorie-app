# ============================================
# Food Calorie Analyzer - Environment Config
# ============================================
# Architecture: Local/Offline First
# - MongoDB: Docker container
# - AI Model: Docker (Ollama with LLaVA/Moondream)
# - Nutrition: USDA API (external, but cached locally)

# ============================================
# Docker Services Configuration
# ============================================

# MongoDB (Docker)
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB_NAME=food_calorie_app

# Ollama AI Model (Docker)
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=llava
# Alternative lighter models: moondream, bakllava

# ============================================
# External API Configuration
# ============================================

# Hugging Face (Cloud Fallback - Optional)
# Get from: https://huggingface.co/settings/tokens
HF_API_TOKEN=
HF_FOOD_MODEL=microsoft/Food-101

# USDA FoodData Central (Nutrition Data)
USDA_API_KEY=ZEfV9ivGfKwg6R0cJeeRJH8R8EZ4GOS3lnvCpbXU

# ============================================
# Processing Configuration
# ============================================

# Use local Docker services first
USE_LOCAL_FIRST=true

# Offline Mode (true = no external APIs, use cached/estimated data only)
OFFLINE_MODE=false

# Confidence threshold for food detection
CONFIDENCE_THRESHOLD=0.3

# Default portion size for estimation
DEFAULT_PORTION_SIZE=100

# ============================================
# API Configuration
# ============================================

# Backend API
API_HOST=0.0.0.0
API_PORT=8000

# CORS Settings
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# ============================================
# Logging Configuration
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path
LOG_FILE=/app/logs/app.log

# ============================================
# Performance Configuration
# ============================================

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# Maximum image size (MB)
MAX_IMAGE_SIZE=10

# Cache duration for nutrition data (seconds)
NUTRITION_CACHE_DURATION=3600

# ============================================
# Development Settings
# ============================================

# Enable auto-reload (development only)
RELOAD=true

# Enable debug mode
DEBUG=false

# YOLO MODEL PATH
YOLO_MODEL_PATH = "/yolo/models/FoodModel.pt"